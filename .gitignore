# ==========================================
#  Alkagol — Root .gitignore
# ==========================================

# ---------- Secrets / Environment ----------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
secrets/

# ---------- Python / Django ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
logs/
db.sqlite3
db.sqlite3-journal
/backend/staticfiles/
/backend/media/
!/backend/media/.gitkeep
local_settings.py

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- Node / Next.js ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/

# ---------- Docker / Infra ----------
docker-compose.override.yml
certbot/
nginx/ssl/
backups/
*.dump
*.sql.gz

# ---------- IDE / OS ----------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Claude / AI tooling ----------
.claude/settings.local.json
