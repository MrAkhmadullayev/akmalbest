# =============================================================================
#  ALKAGOL — Docker Compose environment
# =============================================================================
#  Nusxa oling:   cp .env.example .env
#  SECRET_KEY:    make secret        (yoki: openssl rand -base64 48)
#  .env HECH QACHON git'ga tushmaydi (.gitignore'da).
# =============================================================================

# -----------------------------------------------------------------------------
# Server hajmi
# -----------------------------------------------------------------------------
# LOWMEM=1  -> RAM 1 GB yoki kamroq (AWS EC2 t3.micro, 512MB droplet).
#              docker-compose.lowmem.yml avtomatik qo'shiladi: Postgres va
#              Redis siqiladi, Gunicorn 1 worker'ga tushadi, celery_beat
#              alohida konteyner o'rniga worker ichida ishlaydi, certbot
#              demoni o'chadi (sertifikatni cron yangilaydi).
#              SWAP FAOL BO'LISHI SHART — tekshirish: swapon --show
# LOWMEM=0  -> 2 GB va undan katta serverlar uchun (standart konfiguratsiya)
#
# t3.micro = 1 GB -> LOWMEM=1
LOWMEM=1

# -----------------------------------------------------------------------------
# Domen
# -----------------------------------------------------------------------------
# Domen olganingizda shu yerni to'ldiring, keyin: make ssl
# Domen hali yo'q bo'lsa serverning IP manzilini yozing (HTTPS ishlamaydi).
DOMAIN=alkagol.example.com
# Let's Encrypt sertifikat ogohlantirishlari uchun email
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_openssl_rand_base64_48
DEBUG=False

# Vergul bilan, sxemasiz. Nginx ichki proxy uchun "backend" ham kerak.
ALLOWED_HOSTS=alkagol.example.com,www.alkagol.example.com,backend,localhost,127.0.0.1

# Sxema BILAN (https://). Django 4+ CSRF uchun majburiy.
CSRF_TRUSTED_ORIGINS=https://alkagol.example.com,https://www.alkagol.example.com

# Frontend nginx orqali bir xil origin'dan chiqadi, shuning uchun CORS deyarli
# kerak emas. Alohida domendan chaqirsangiz shu yerga qo'shing.
CORS_ALLOWED_ORIGINS=https://alkagol.example.com

# Nginx TLS'ni tugatadi -> Django'ga X-Forwarded-Proto keladi.
# DIQQAT: quyidagi 8 qator LOKAL compose uchun. Prod compose ularni qattiq
# `True` qilib beradi, ya'ni prod'da bu yerdagi qiymat e'tiborga olinmaydi.
# Lokalda HTTPS yo'q -> SESSION/CSRF_COOKIE_SECURE ni False qiling.
TRUST_PROXY_SSL_HEADER=True
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=False        # redirectni nginx qiladi, ikki marta kerak emas
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Admin panel manzili — botlar /admin/ ni birinchi bo'lib uradi
ADMIN_URL=admin
# Prod'da Swagger'ni yopish uchun False
ENABLE_API_DOCS=True

LOG_LEVEL=INFO
LOG_TO_FILE=False
TIME_ZONE=Asia/Tashkent

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=alkagol_db
POSTGRES_USER=alkagol_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Quyidagilar LOKAL compose uchun. docker-compose.prod.yml ularni o'zi
# qattiq belgilaydi (db/5432/False), shuning uchun prod'da o'zgartirish
# ta'sir qilmaydi.
DATABASE_HOST=db
DATABASE_PORT=5432
DB_CONN_MAX_AGE=60
USE_SQLITE=False

# -----------------------------------------------------------------------------
# Redis / Celery  (prod compose bularni ham qattiq belgilaydi)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME=60      # daqiqa
JWT_REFRESH_TOKEN_LIFETIME=1440   # daqiqa (24 soat)

# -----------------------------------------------------------------------------
# Gunicorn
# -----------------------------------------------------------------------------
# Tavsiya: (2 x CPU) + 1.  2 vCPU droplet uchun 5.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Nisbiy yo'l -> brauzer o'zi turgan domenga so'rov yuboradi -> CORS yo'q.
# Faqat LOKAL compose'da ishlaydi (build-arg sifatida uzatiladi). Prod'da bu
# qiymat image ichiga CI build vaqtida `/api` sifatida qotib qoladi.
NEXT_PUBLIC_API_URL=/api

# -----------------------------------------------------------------------------
# Container image'lar (CI/CD GHCR'dan tortadi)
# -----------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=your-github-username
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Birinchi ishga tushirishda avtomatik superuser (ixtiyoriy)
# Bo'sh qoldirilsa superuser yaratilmaydi.
# -----------------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
