# =============================================================================
#  Backend — LOKAL development (Docker'siz: python manage.py runserver)
#  Nusxa oling:  cp backend/.env.example backend/.env
#  Docker orqali ishlatsangiz bu fayl KERAK EMAS — root .env ishlatiladi.
# =============================================================================

SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# Tez sinov uchun SQLite: USE_SQLITE=True
# Prod bilan bir xil bo'lishi uchun Postgres tavsiya etiladi (docker compose up db)
USE_SQLITE=True
DATABASE_NAME=alkagol_db
DATABASE_USER=alkagol_user
DATABASE_PASSWORD=alkagol_dev_pass
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Boshqa
ADMIN_URL=admin
ENABLE_API_DOCS=True
LOG_LEVEL=DEBUG
LOG_TO_FILE=True
TIME_ZONE=Asia/Tashkent
